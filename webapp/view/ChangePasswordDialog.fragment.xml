<core:FragmentDefinition
	xmlns="sap.m"
	xmlns:core="sap.ui.core"
	xmlns:f="sap.ui.layout.form">

	<Dialog
		title="{i18n>changePassword}"
		contentWidth="26rem"
		class="sppDialog">

		<content>
			<MessageStrip
				text="{i18n>changePasswordHint}"
				type="Information"
				showIcon="true"
				class="sppLoginStrip"/>

			<f:SimpleForm
				editable="true"
				layout="ResponsiveGridLayout"
				labelSpanXL="12" labelSpanL="12" labelSpanM="12" labelSpanS="12"
				adjustLabelSpan="false"
				columnsXL="1" columnsL="1">
				<f:content>
					<Label text="{i18n>currentPassword}" labelFor="currentPassword"/>
					<Input id="currentPassword" type="Password"/>

					<Label text="{i18n>newPassword}" labelFor="newPassword"/>
					<Input id="newPassword" type="Password"/>

					<Label text="{i18n>repeatPassword}" labelFor="repeatPassword"/>
					<Input id="repeatPassword" type="Password" submit=".onSubmitChangePassword"/>
				</f:content>
			</f:SimpleForm>

			<Text text="{i18n>passwordPolicy}" class="sppMuted sppPolicyText"/>
		</content>

		<beginButton>
			<Button text="{i18n>save}" type="Emphasized" press=".onSubmitChangePassword"/>
		</beginButton>
		<endButton>
			<Button text="{i18n>cancel}" press=".onCancelChangePassword"/>
		</endButton>
	</Dialog>
</core:FragmentDefinition>
